# Environment Variables Template for Zaenal Alfian Portfolio Project

# Prisma PostgreSQL Database Connection URL
DATABASE_URL="postgresql://portfolio_user:strong_password@localhost:5432/portfolio_db"

# NextAuth Authentication Security Config
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional Shadow Database URL for migrations
# SHADOW_DATABASE_URL="postgresql://portfolio_user:strong_password@localhost:5432/portfolio_db_shadow"

# GitHub Public Contributions API
GITHUB_API_PUBLIC="https://github-contributions-api.jogruber.de/v4/"
NEXT_PUBLIC_GITHUB_API_PUBLIC="https://github-contributions-api.jogruber.de/v4/"
