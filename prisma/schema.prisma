// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  password     String
  role         Role     @default(ADMIN)
  position     String?
  activity     String?
  experience   String?
  location     String?
  availability String?
  quotes       String?
  bio          String?
  resume       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  about        About?
  contact      Contact?
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  category     String
  thumbnail    String
  images       String[] @default([])
  techstack    String[]
  problem      String?
  solution     String?
  architecture String?
  challenge    String?
  result       String?
  repository   String?
  sourceLink   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  description String
  content     String
  thumbnail   String?
  keywords    String[]
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Doc {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  description String
  content     String
  order       Int      @default(99)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  role        String
  company     String
  period      String
  isCurrent   Boolean  @default(false)
  description String
  skills      String[] @default([])
  order       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skillset {
  id            String   @id @default(cuid())
  skillName     String   @map("skill_name")
  category      String
  categoryOrder Int      @default(1) @map("category_order")
  link          String?
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("skillsets")
}

model About {
  id          String      @id @default(cuid())
  userId      String      @unique @map("user_id")
  title       String
  subtitle    String
  excerpt     String
  description String
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       AboutCard[]

  @@map("abouts")
}

model AboutCard {
  id        String   @id @default(cuid())
  aboutId   String   @map("about_id")
  title     String
  subtitle  String
  badge     String?  @map("badge")
  order     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  about     About    @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  @@map("about_cards")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  gmail     String?
  whatsapp  String?
  github    String?
  linkedin  String?
  instagram String?
  facebook  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contacts")
}
