// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ContentStatus {
  draft
  published
  archived
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  password     String
  role         Role     @default(ADMIN)
  position     String?
  activity     String?
  experience   String?
  location     String?
  availability String?
  quotes       String?
  bio          String?
  resume       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  about        About?
  contact      Contact?

  @@map("users")
}

model Project {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String
  category      String
  thumbnail     String
  images        String[]      @default([])
  techstack     String[]
  problem       String?
  solution      String?
  architecture  String?
  challenge     String?
  result        String?
  repository    String?
  sourceLink    String?       @map("source_link")
  priorityOrder Int           @default(1) @map("priority_order")
  status        ContentStatus @default(published) @map("status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("projects")
}

model Blog {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  category    String
  description String
  content     String
  thumbnail   String?
  keywords    String[]
  status      ContentStatus @default(published) @map("status")
  publishedAt DateTime      @default(now()) @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("blogs")
}

model Doc {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  category    String
  description String
  content     String
  order       Int           @default(99)
  status      ContentStatus @default(published) @map("status")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("docs")
}

model Experience {
  id              String   @id @default(cuid())
  role            String
  company         String
  period          String
  isCurrent       Boolean  @default(false) @map("is_current")
  description     String
  accomplishments String[] @default([])
  skills          String[] @default([])
  order           Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("experiences")
}

model Skillset {
  id            String   @id @default(cuid())
  skillName     String   @map("skill_name")
  category      String
  categoryOrder Int      @default(1) @map("category_order")
  link          String?
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("skillsets")
}

model About {
  id          String      @id @default(cuid())
  userId      String      @unique @map("user_id")
  title       String
  subtitle    String
  excerpt     String
  description String
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       AboutCard[]

  @@map("abouts")
}

model AboutCard {
  id        String   @id @default(cuid())
  aboutId   String   @map("about_id")
  title     String
  subtitle  String
  badge     String?  @map("badge")
  icon      String?  @map("icon")
  order     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  about     About    @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  @@map("about_cards")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  gmail     String?
  whatsapp  String?
  github    String?
  linkedin  String?
  instagram String?
  facebook  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Education {
  id             String   @id @default(cuid())
  title          String
  organization   String
  location       String
  period         String
  statusBadge    String?  @map("status_badge")
  grades         String?
  educationLevel String?  @map("education_level")
  description    String
  highlights     String[] @default([])
  courses        String[] @default([])
  order          Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("educations")
}
